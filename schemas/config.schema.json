{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jev.local/config.schema.json",
  "title": "JEV Runtime Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "commanders"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "commanders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "side", "unitIds", "ability", "style"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "side": {
            "type": "string",
            "minLength": 1
          },
          "parentId": {
            "type": "string"
          },
          "unitIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "ability": {
            "type": "string"
          },
          "style": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "tactics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "doctrineId": {
                "type": "string"
              },
              "modifiers": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "parameters": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/goal"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "silent-auto"
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "decisionBudgetMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "retryDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "tickDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "narrativeWindow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "narrativeRoles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "narrativeMode": {
          "enum": ["auto", "manual", "off"]
        },
        "maxModelCallsPerDecision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "modelActionMode": {
          "enum": ["local", "model"]
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "candidateLimit",
          "horizon",
          "factors",
          "coordination",
          "branches",
          "enemyResponses"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "candidateLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "horizon": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "factors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "objective",
                "threat",
                "role",
                "terrain",
                "phase",
                "response",
                "reserve",
                "cross-group"
              ]
            }
          },
          "coordination": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "branches": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "enemyResponses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stages", "capabilities"],
      "properties": {
        "id": {
          "type": "string"
        },
        "stages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxIdleTurns": {
          "type": "integer",
          "minimum": 1
        },
        "maxRepairs": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "definitions": {
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "priority", "source", "version", "side"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 159
        },
        "title": {
          "type": "string",
          "maxLength": 2000
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "source": {
          "enum": ["user", "host", "narrative", "default"]
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "side": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
